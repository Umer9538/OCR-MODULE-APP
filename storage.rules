rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Health records storage - open for development
    match /health_records/{allPaths=**} {
      allow read, write: if true;
    }

    // Default deny for other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
